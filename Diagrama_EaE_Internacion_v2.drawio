x="685.0" y="648.0" width="170" height="34" as="geometry"/></mxCell><mxCell id="r8" value="ITO(i) = T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960.0" y="548.0" width="140" height="34" as="geometry"/></mxCell><mxCell id="r9" value="TPS(i) = HV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="960.0" y="598.0" width="140" height="34" as="geometry"/></mxCell><mxCell id="f1" value="T ≤ TF" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500.0" y="1112.0" width="160" height="56" as="geometry"/></mxCell><mxCell id="c1b" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="793.0" y="1123.0" width="34" height="34" as="geometry"/></mxCell><mxCell id="f2" value="NS = 0" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500.0" y="1202.0" width="160" height="56" as="geometry"/></mxCell><mxCell id="f3" value="TPLL = HV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="745.0" y="1213.0" width="130" height="34" as="geometry"/></mxCell><mxCell id="f3n" value="Vaciamiento" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Times New Roman;fontSize=9;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="750.0" y="1255.0" width="120" height="20" as="geometry"/></mxCell><mxCell id="c1c" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="943.0" y="1213.0" width="34" height="34" as="geometry"/></mxCell><mxCell id="f4" value="PTO(i) = STO(i) · 100 / T        (i = 1 … N)&lt;br&gt;PEC = (STS − STLL − STA) / (CLL − CDER)&lt;br&gt;PDER = CDER · 100 / CLL&lt;br&gt;CT = [ Σ STO(i) · CCO + CDER · IPP ] · 30 / T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="385.0" y="1309.0" width="390" height="92" as="geometry"/></mxCell><mxCell id="f5" value="N,  PTO(i),  PEC,  PDER,  CT" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.25;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="435.0" y="1435.0" width="290" height="40" as="geometry"/></mxCell><mxCell id="f6" value="FIN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525.0" y="1508.0" width="110" height="34" as="geometry"/></mxCell><mxCell id="ref" value="REFERENCIAS&lt;br&gt;IA: intervalo entre arribos (días) · TI: tiempo de internación (días)&lt;br&gt;N: cantidad de camas · MAXC: máx. pacientes esperando cama&lt;br&gt;NS: pacientes en el sistema (internados + en espera)&lt;br&gt;TPLL / TPS(i): tiempo de próxima llegada / salida (alta) de la cama i&lt;br&gt;ITO(i) / STO(i): inicio / sumatoria de tiempo ocioso de la cama i&lt;br&gt;CLL: cantidad de llegadas · CDER: cantidad de derivados&lt;br&gt;STLL: sumatoria de tiempos de llegada (de los que entran)&lt;br&gt;STS: sumatoria de tiempos de salida&lt;br&gt;STA: sumatoria de tiempos de internación&lt;br&gt;PTO(i): % tiempo ocioso · PEC: promedio de espera en cola (días)&lt;br&gt;PDER: % derivados · CT: costo total mensual (USD/mes)&lt;br&gt;CCO: costo día-cama ociosa · IPP: ingreso perdido por derivación" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780.0" y="1327.5" width="390" height="225" as="geometry"/></mxCell><mxCell id="e0" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="in" target="ci"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci" target="men"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1a" target="men"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="100"/></Array></mxGeometry></mxCell><mxCell id="e3" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="men" target="d0"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e4" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d0" t